[Unit]
Description=ANDSpeak LifeStory Proof-of-Concept
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aidas
Group=aidas
WorkingDirectory=/opt/ANDSpeak-LifeStory
EnvironmentFile=/opt/ANDSpeak-LifeStory/.env
ExecStart=/opt/ANDSpeak-LifeStory/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5001 server:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
